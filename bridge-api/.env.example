# ============================
# Bridge API + EC2 Agent (Lightsail 통합)
# ============================

# 인증
BRIDGE_API_KEY=your_bridge_api_key_here
BRIDGE_JWT_SECRET=your_jwt_secret_here

# Gemini AI
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_CONFIG_MODEL=gemini-2.5-flash
GEMINI_CONTENT_MODEL=gemini-2.5-flash-lite
GEMINI_CONTENT_FALLBACK_MODEL=gemini-2.5-flash

# OpenAI (AI Citation Tracker — ChatGPT 테스트용, 선택)
OPENAI_API_KEY=
# Anthropic (AI Citation Tracker — Claude 테스트용, 선택)
ANTHROPIC_API_KEY=

# Score Checker — 외부 API (선택, 없으면 해당 카테고리 건너뜀)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
KAKAO_REST_API_KEY=
GOOGLE_PLACES_API_KEY=

# Bing Webmaster API
BING_WEBMASTER_API_KEY=
BING_WEBMASTER_TIMEOUT_MS=15000
BING_WEBMASTER_MAX_RETRIES=4
BING_WEBMASTER_RETRY_BASE_MS=2000
# Bing ownership verification meta tag content
# Example: if Bing gives <meta name="msvalidate.01" content="ABC123" />, set ABC123
BING_SITE_VERIFICATION=

# IndexNow — Bing/Yandex/Naver 즉시 색인 프로토콜
# 키는 16-byte hex (openssl rand -hex 16). 모든 서버가 같은 값을 가져야 함.
# 설정되지 않으면 /root/.wp-bulk-indexnow-key 파일로 fallback.
# INDEXNOW_KEY (shell script 변수명)도 허용됨.
INDEXNOW_API_KEY=
# 2026-04-22 Bing 적극 제출 금지 방침 — 기본값 false.
# "Bing 이 스스로 크롤링" 전략이라 능동 제출 차단. 활성화하려면 true 명시.
INDEXNOW_ENABLED=false

# Bing SubmitUrlBatch — 발행 시 URL 단건 Bing 직접 제출 (하루 10k 한도)
# 2026-04-22 Bing 적극 제출 금지 방침 — 기본값 false.
# sitemap 제출(syncBingSite)은 영향 없음. 활성화하려면 true 명시.
BING_URL_SUBMISSION_ENABLED=false

# EC2 Agent 연결 (같은 서버 — localhost)
EC2_AGENT_URL=http://127.0.0.1:4001
EC2_AGENT_KEY=your_bridge_api_key_here

# CORS (쉼표로 여러 origin 지정 가능)
CORS_ORIGIN=https://wp.multiful.ai,https://wp-bulk-generator.vercel.app,https://admin.allmyreview.site,http://localhost:3000,http://127.0.0.1:3000

# Bridge API 서버 설정
PORT=4000
HOST=0.0.0.0
DASHBOARD_CACHE_PATH=/home/ubuntu/wp-bulk-generator/bridge-api/data/dashboard-cache.json

# ============================
# EC2 Agent 설정 (같은 .env 파일에서 읽음)
# ============================
EC2_AGENT_PORT=4001
CREDENTIALS_PATH=/home/ubuntu/wp-bulk-generator/bridge-api/data/wp-sites-credentials.json
CONFIG_PATH=/home/ubuntu/wp-bulk-generator/bridge-api/data/wp-sites-config.json
GROUPS_PATH=/home/ubuntu/wp-bulk-generator/bridge-api/data/site-groups.json
DEPLOY_SCRIPT_PATH=/home/ubuntu/wp-bulk-generator/scripts/deploy-wp-sites.sh
